NALLPUTER_TOKEN=dev-token
NALLPUTER_PROVIDER=local
NALLPUTER_RUNTIME=nallputer-0.1.0
NALLPUTER_REVISION=cf8834e
NALLPUTER_WORKSPACE=/home/nally/workspace
NALLPUTER_RAM_MB=512
NALLPUTER_CPU_MILLICORES=500
NALLPUTER_DISK_GB=2
NALLPUTER_MAX_PIDS=100
NALLPUTER_WALL_TIME_SEC=300
NALLPUTER_MAX_OUTPUT_BYTES=100000
NALLPUTER_WORKSPACE_GB=1
NALLPUTER_EGRESS_POLICY=deny-by-default
NALLPUTER_EGRESS_ALLOWLIST=pypi.org,registry.npmjs.org,github.com
NALLPUTER_IDLE_TIMEOUT_SEC=900
# 011 8A — S3-compatible canonical (provider is deployment config)
# Local fallback (default): leave S3_BUCKET empty and canonical is local FS
NALLPUTER_CANONICAL=/home/nally/workspace/.nallputer-canonical
# S3-compatible (set to use object store; with moto for tests set ENDPOINT=mock)
# NALLPUTER_S3_BUCKET=nallputer-canonical
# NALLPUTER_S3_ENDPOINT=https://s3.amazonaws.com  # or https://xxx.r2.cloudflarestorage.com or mock
# NALLPUTER_S3_REGION=us-east-1
# NALLPUTER_S3_ACCESS_KEY=
# NALLPUTER_S3_SECRET_KEY=
# NALLPUTER_S3_PREFIX=
